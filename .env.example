# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# ADMIN_PASSWORD & PENGAWAS_PASSWORD:
# Optional server-side passcodes. If left empty on first run, the app shows an inline
# first-run activation form to set and hash Admin & Pengawas passwords safely.
ADMIN_PASSWORD=
PENGAWAS_PASSWORD=

# GOOGLE_APPS_SCRIPT_URL: Web App URL deployed from /google-apps-script/Code.gs
GOOGLE_APPS_SCRIPT_URL=

# GOOGLE_SHEET_SYNC_SECRET: Optional shared secret configured in Apps Script Properties
GOOGLE_SHEET_SYNC_SECRET=

# Optional Supabase Configuration (if deploying alongside Supabase PostgreSQL + Realtime)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
